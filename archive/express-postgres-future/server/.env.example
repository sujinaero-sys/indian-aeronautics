# Copy to .env (never commit .env). NODE_ENV: development | test | production
NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://ia:ia_dev_pw@localhost:5432/ia_dev
TEST_DATABASE_URL=postgres://ia:ia_dev_pw@localhost:5432/ia_test
APP_SECRET=generate-a-long-random-string-for-production
FRONTEND_ORIGIN=http://localhost:3000
# Production only (leave empty locally; no email service is needed in development):
RESEND_API_KEY=
GOOGLE_CLIENT_ID=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
